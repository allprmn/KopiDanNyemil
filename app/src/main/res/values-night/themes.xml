<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <!-- Ubah parent menjadi MaterialComponents agar cocok dengan komponen UI kita -->
    <style name="Base.Theme.KopiDanNyemil" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Terapkan warna yang sama agar aplikasi tidak crash -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary</item>
        <item name="colorOnSecondary">@color/primary</item>

        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>